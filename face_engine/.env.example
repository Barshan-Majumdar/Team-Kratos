# ==========================================
# CREW HRMS - FACE ENGINE ENVIRONMENT VARIABLES
# ==========================================

# Note: The face engine runs via FastAPI/Uvicorn on Docker.
# Currently, it does not require external API keys, as it performs
# on-device inference using ONNX models.

# If you ever need to connect this to an external service or logging
# tool, define the environment variables here.

# Example:
# HOST=0.0.0.0
# PORT=8000
ALLOWED_ORIGINS=*

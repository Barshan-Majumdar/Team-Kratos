generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      String   @id @default(uuid())
  name                    String
  domain                  String?  @unique
  planTier                String   @default("Free")
  notificationPreferences Json?

  // Company Details & Statutory Info
  pan                     String?
  gstin                   String?
  cin                     String?
  industry                String?
  size                    String?
  founded                 String?
  address                 String?
  city                    String?
  state                   String?
  pincode                 String?
  country                 String?

  // Organizational Structure
  departments             String[]
  customRoles             Json?    // Stores the array of roles [{name, level, locked, canManage, description}]

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users            User[]
  attendances      Attendance[]
  leaves           Leave[]
  payrolls         Payroll[]
  payrollConfigs   PayrollConfig[]
  auditLogs        AuditLog[]
  adminEmails      AdminEmail[]
  invitedEmployees InvitedEmployee[]
  salaryAdvances   SalaryAdvance[]
  announcements    Announcement[]

  legalEntities        LegalEntity[]
  subscriptions        Subscription[]
  usageRecords         UsageRecord[]
  complianceRules      ComplianceRule[]
  importJobs           ImportJob[]
  webhookSubscriptions WebhookSubscription[]
  apiKeys              ApiKey[]

  offices              Office[]
  leavePolicies        LeavePolicy[]
  shiftPolicies        ShiftPolicy[]
  onboardingChecklists OnboardingChecklist[]
  onboardingTasks      OnboardingTask[]
  goals                Goal[]
  reviews              Review[]
  feedbacks360         Feedback360[]
  tickets              Ticket[]
  expenseClaims        ExpenseClaim[]
  documentTemplates    DocumentTemplate[]
  generatedDocuments   GeneratedDocument[]
  signatureRequests    SignatureRequest[]
  proxyAlerts          ProxyAlert[]
  jobRequisitions      JobRequisition[]
  candidates           Candidate[]
  applications         Application[]
  assets               Asset[]
  assetAssignments     AssetAssignment[]
  projects             Project[]
  timesheetEntries     TimesheetEntry[]
  oneOnOnes            OneOnOne[]
  pulseSurveys         PulseSurvey[]
  pulseResponses       PulseResponse[]
  hrDocuments          HRDocument[]
}

enum Role {
  SuperAdmin
  CEO
  Admin
  Manager
  Employee
}

enum Status {
  Active
  Inactive
  OnLeave
}

model Office {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  lat           Float
  lng           Float
  radiusMeters  Float    @default(100)
  address       String?
  state         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       User[]
  attendances Attendance[]
}

model ShiftPolicy {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model LeavePolicy {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  annualQuota     Float
  carryForward    Boolean  @default(false)
  maxCarryForward Float?
  isPaid          Boolean  @default(true)
  createdAt       DateTime @default(now())

  leaves Leave[]
}

model User {
  id                 String       @id @default(uuid())
  tenantId           String?
  tenant             Tenant?      @relation(fields: [tenantId], references: [id])
  entityId           String?
  legalEntity        LegalEntity? @relation(fields: [entityId], references: [id])
  officeId           String?
  office             Office?      @relation(fields: [officeId], references: [id])
  shiftPolicyId      String?
  shiftPolicy        ShiftPolicy? @relation(fields: [shiftPolicyId], references: [id])
  employeeId         String?
  email              String       @unique
  password           String
  role               Role         @default(Employee)
  mustChangePassword Boolean      @default(true)
  status             Status       @default(Active)

  emailVerified      Boolean      @default(false)
  otpCode            String?
  otpExpiry          DateTime?

  displayName     String?
  avatar          String?
  department      String?
  jobPosition     String?
  managerId       String?
  manager         User?    @relation("UserManager", fields: [managerId], references: [id])
  subordinates    User[]   @relation("UserManager")
  about           String?
  skills          String[]
  certifications  String[]
  phone           String?
  residingAddress String?
  personalEmail   String?
  gender          String?
  nationality     String?
  maritalStatus   String?
  location        String?

  companyName String?
  companyLogo String?

  bankName      String?
  bankBranch    String?
  accountNumber String?
  ifscCode      String?
  panNo         String?
  aadharNo      String?
  voterIdNo     String?

  aadharDoc       String?
  panDoc          String?
  voterDoc        String?
  addressProofDoc String?

  uanNo         String?
  empCode       String?
  dateOfBirth   DateTime?
  dateOfJoining DateTime? @default(now())

  workingDaysPerWeek Int   @default(5)
  breakTimeHrs       Float @default(1)
  baseSalary         Float @default(0)
  
  attritionRiskScore Float?
  attritionRiskLabel String?
  riskUpdatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]
  leaves      Leave[]
  payrolls    Payroll[]
  advances    SalaryAdvance[]
  assetAssignments AssetAssignment[]
  timesheetEntries TimesheetEntry[]
  tickets     Ticket[]
  goals       Goal[]
  onboardingTasks OnboardingTask[]

  @@unique([tenantId, employeeId])
}

enum AttendanceStatus {
  Present
  Absent
  HalfDay
  OnLeave
}

model Attendance {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  officeId   String?
  office     Office?          @relation(fields: [officeId], references: [id])
  date       DateTime         @db.Date
  checkIn    DateTime
  checkOut   DateTime?
  workHours  Float            @default(0)
  extraHours Float            @default(0)
  breakHours Float            @default(1)
  status     AttendanceStatus @default(Present)

  latitude  Float?
  longitude Float?
  trustScore        Int?
  verificationMethod String?
  isLivenessVerified Boolean @default(false)
  livenessEmbeddingHash String?
  isFlagged         Boolean @default(false)
  flagReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, date])
  @@index([tenantId, userId, date])
}

enum DurationType {
  FullDay
  HalfDay
  Hourly
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
}

model Leave {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  leavePolicyId String
  leavePolicy  LeavePolicy @relation(fields: [leavePolicyId], references: [id])
  durationType DurationType @default(FullDay)
  hoursRequested Float?
  startDate    DateTime
  endDate      DateTime
  reason       String
  attachment   String?
  status       LeaveStatus @default(Pending)
  adminRemarks String?
  approvedById String?
  approvedAt   DateTime?
  managerId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

model Payroll {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  entityId          String?
  legalEntity       LegalEntity? @relation(fields: [entityId], references: [id])
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  month             String
  monthWage         Float
  payableDays       Int
  basicSalary       Float
  hra               Float
  standardAllowance Float        @default(4167.00)
  performanceBonus  Float
  lta               Float
  pfEmployee        Float
  pfEmployer        Float
  professionalTax   Float        @default(200.00)
  fixedAllowance    Float
  
  overtimeHours     Float   @default(0)
  overtimeBonus     Float   @default(0)
  lateDeductions    Float   @default(0)
  advanceDeduction  Float   @default(0)
  expenseReimburse  Float   @default(0)
  deductionBreakdown Json?
  bonusBreakdown     Json?

  grossSalary       Float
  netSalary         Float
  locked            Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, month])
}

model PayrollConfig {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  companyName         String
  pfEmployeePercent   Float    @default(12.0)
  pfEmployerPercent   Float    @default(12.0)
  professionalTax     Float    @default(200.0)
  standardAllowance   Float    @default(4167.0)
  basicPercentOfWage  Float    @default(50.0)
  hraPercentOfBasic   Float    @default(50.0)
  bonusPercentOfBasic Float    @default(8.33)
  ltaPercentOfBasic   Float    @default(8.33)
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, companyName])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  actorId   String
  action    String
  targetId  String?
  details   Json?
  prevHash  String?
  hash      String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model AdminEmail {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
}

model InvitedEmployee {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
}

enum AdvanceStatus {
  Pending
  Approved
  Rejected
}

model SalaryAdvance {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Float
  reason         String
  monthDeduction String 
  status         AdvanceStatus @default(Pending)
  
  riskScore      Float?
  riskLabel      String?
  settledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

model Announcement {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  adminId  String
  message  String

  createdAt DateTime @default(now())
}

model LegalEntity {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  pfCode    String?
  ptRegNo   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  payrolls Payroll[]

  @@unique([tenantId, name])
}

model Subscription {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  razorpayPlanId String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UsageRecord {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  month           String 
  activeEmployees Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, month])
}

model ComplianceRule {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  state         String
  ruleType      String 
  effectiveFrom DateTime
  rateTable     Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ImportJob {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  status        String   @default("pending") 
  sourceFile    String
  mappingConfig Json?
  errorLog      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  eventType String
  targetUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  keyHash   String   @unique
  keyPrefix String
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
}

model OnboardingChecklist {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now())
}

model OnboardingTask {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Goal {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  title       String
  description String?
  progress    Int      @default(0)
  status      String   @default("In Progress")
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  title     String
  createdAt DateTime @default(now())
}

model Feedback360 {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

enum TicketStatus {
  Open
  InProgress
  Resolved
}

enum TicketCategory {
  HR
  IT
  Payroll
}

model Ticket {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String   @default("Support Request")
  description String?
  status      TicketStatus @default(Open)
  category    TicketCategory @default(HR)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseClaim {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  amount    Float
  status    String   @default("Pending")
  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

model DocumentTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now())
}

model GeneratedDocument {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  url       String
  createdAt DateTime @default(now())
}

model SignatureRequest {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  status    String   @default("Pending")
  createdAt DateTime @default(now())
}

model ProxyAlert {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  reason    String
  createdAt DateTime @default(now())
}

model JobRequisition {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  title     String
  createdAt DateTime @default(now())
}

model Candidate {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now())
}

enum ApplicationStage {
  Applied
  Screening
  Interview
  Offer
  Hired
  Rejected
}

model Application {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  stage     ApplicationStage @default(Applied)
  createdAt DateTime @default(now())
}

enum AssetStatus {
  Available
  Assigned
  Maintenance
}

model Asset {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  status    AssetStatus @default(Available)
  createdAt DateTime @default(now())
}

model AssetAssignment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Project {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now())
}

model TimesheetEntry {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hours     Float
  createdAt DateTime @default(now())
}

model OneOnOne {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  notes     String
  createdAt DateTime @default(now())
}

model PulseSurvey {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  title     String
  createdAt DateTime @default(now())
}

model PulseResponse {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  rating    Int
  createdAt DateTime @default(now())
}

model HRDocument {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

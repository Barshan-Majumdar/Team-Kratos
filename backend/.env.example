# ==========================================
# CREW HRMS - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=*

# Database Configuration (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/crewhrms?schema=public"
REDIS_URL=redis://127.0.0.1:6379

# Security & Encryption
JWT_SECRET=your_super_secret_jwt_key
FACE_EMBEDDING_ENCRYPTION_KEY=your_encryption_key_for_biometrics
PULSE_SALT=crew_pulse_secret_salt_123

# Service URLs (Critical for Emails & Microservices)
FRONTEND_URL=http://localhost:5173
PYTHON_ENGINE_URL=http://localhost:8000
MARKETING_URL=http://localhost:3001

# ── Missing Production Variables ────────────────────────────
FACE_EMBEDDING_ENCRYPTION_KEY=super_secret_encryption_key_123!@#
PULSE_SALT=crew_pulse_secret_salt_123
RAZORPAY_KEY_ID=rzp_test_example_id
RAZORPAY_KEY_SECRET=rzp_test_example_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Email Notifications (SMTP)
MAIL_FROM=notifications@yourdomain.com
GMAIL_APP_PASSWORD=your_gmail_app_password_or_smtp_key

# Image Hosting / CDN (ImageKit)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Billing & Subscriptions (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

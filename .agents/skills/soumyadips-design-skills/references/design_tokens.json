{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "soumyadips-design-tokens",
  "version": "1.0.0",
  "author": "Soumyadip Mondal",
  "description": "Executive Anti-AI-Slop Frontend Token System for Team-Kratos",
  "tokens": {
    "color": {
      "canvas": {
        "value": "#FAF9F6",
        "type": "color",
        "description": "Warm slate paper background canvas"
      },
      "card": {
        "value": "#FFFFFF",
        "type": "color",
        "description": "Pure crisp white inner card surface"
      },
      "bezel": {
        "value": "#F4F1EA",
        "type": "color",
        "description": "Doppelrand outer shell background"
      },
      "navy": {
        "primary": "#1F2B4D",
        "hover": "#141C33",
        "subtle": "#F0F3F9",
        "type": "color",
        "description": "Executive Navy primary identity token"
      },
      "clay": {
        "text": "#8C5722",
        "fill": "#B5793A",
        "bg": "#FDF8F3",
        "border": "#EEDCCE",
        "type": "color",
        "description": "Founder Privilege Warm Clay token system"
      },
      "emerald": {
        "text": "#065F46",
        "fill": "#10B981",
        "bg": "#ECFDF5",
        "border": "#A7F3D0",
        "type": "color",
        "description": "Metric benchmark & target score highlight"
      },
      "neutral": {
        "badgeBg": "#F1F5F9",
        "badgeText": "#1E293B",
        "badgeBorder": "#E2E8F0",
        "type": "color",
        "description": "Single-family desaturated executive badge neutral"
      }
    },
    "typography": {
      "display": {
        "fontFamily": "Fraunces, serif",
        "weights": [600, 700],
        "opticalSizes": "9..144"
      },
      "body": {
        "fontFamily": "Manrope, sans-serif",
        "weights": [400, 500, 600, 700, 800]
      },
      "mono": {
        "fontFamily": "JetBrains Mono, monospace",
        "weights": [500, 700]
      }
    },
    "elevation": {
      "outerRadius": "24px",
      "innerRadius": "16px",
      "pillRadius": "9999px",
      "shadowCard": "0 1px 2px rgba(29,27,22,.04), 0 8px 20px rgba(29,27,22,.06)",
      "shadowHover": "0 6px 24px -4px rgba(29,27,22,.08), 0 12px 32px -6px rgba(29,27,22,.12)",
      "shadowDropdown": "0 12px 32px rgba(15,23,42,.12), 0 4px 12px rgba(15,23,42,.06)"
    },
    "animation": {
      "springTiming": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "springDuration": "500ms"
    }
  }
}
